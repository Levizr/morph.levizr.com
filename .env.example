# Copy to .env.local and fill in. Never commit real secrets.
# Docs content (optional):
GITHUB_TOKEN=

# Sponsor donations (all four required to switch on /sponsor checkout):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
# Webhook secret: Razorpay Dashboard → Settings → Webhooks → your endpoint →
# show secret. Lets Razorpay confirm paid donations even if the donor's
# browser never calls back (closed tab, network drop).
RAZORPAY_WEBHOOK_SECRET=...
